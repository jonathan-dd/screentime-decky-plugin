    "bugs": {
        "url": "https://github.com/jonathan-dd/screentime-decky-plugin/issues"
    },
    "homepage": "https://github.com/jonathan-dd/screentime-decky-plugin#readme",
    "devDependencies": {
        "@decky/rollup": "^1.0.1",
        "@decky/ui": "^4.9.0",
        "@types/react": "18.3.3",
        "@types/react-dom": "18.3.0",
        "@types/webpack": "^5.28.5",
        "rollup": "^4.22.5",
        "typescript": "^5.6.2"
    },
    "dependencies": {
        "@decky/api": "^1.1.2",
        "react-icons": "^5.3.0",
        "tslib": "^2.7.0"
